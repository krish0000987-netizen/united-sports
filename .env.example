# ============================================================
# UNITED SPORTS / UNITEDATHLETES — Supabase environment
# Copy to .env.local and fill in real values (never commit .env.local)
# ============================================================

# Public Supabase project URL (safe in browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key — the "anon"-equivalent client key (safe in browser)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Secret key — SERVER ONLY. Never expose in browser code or VITE_* vars.
SUPABASE_SECRET_KEY=sb_secret_xxxx

# JWKS for JWT verification of admin sessions
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# Storage bucket name used by the CMS
VITE_SUPABASE_STORAGE_BUCKET=website-media
